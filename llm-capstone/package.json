{
  "name": "llm-capstone",
  "version": "0.1.0",
  "description": "Production-grade LLM Question-Answering Service",
  "main": "service/index.js",
  "type": "module",
  "scripts": {
    "start": "node service/index.js",
    "dev": "node --watch service/index.js",
    "test": "TEST_MODE=mock node evals/prompts/test_runner.js",
    "test:prompts": "TEST_MODE=mock node evals/prompts/test_runner.js",
    "test:live": "TEST_MODE=live node evals/prompts/test_runner.js",
    "test:generate-fixtures": "node evals/prompts/generate-fixtures.js",
    "test:generate-selective": "node evals/prompts/generate-fixtures-selective.js",
    "count-tokens": "node scripts/count-tokens.js",
    "confluence-to-md": "node scripts/confluence-to-markdown.js"
  },
  "keywords": [
    "llm",
    "rag",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/vertexai": "^1.7.0",
    "express": "^4.18.2",
    "jsdom": "^26.1.0",
    "mammoth": "^1.6.0",
    "tiktoken": "^1.0.10",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "word-extractor": "^1.0.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "dotenv": "^16.3.1"
  }
}
